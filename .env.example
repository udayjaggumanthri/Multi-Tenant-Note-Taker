# ==============================================================================
# Multi-Tenant Note Taker — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure your values. Do NOT commit .env to git.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_NAME=multitenant_notes
DATABASE_USER=notes_user
DATABASE_PASSWORD=YourSecureStrongPasswordHere
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# 2. DJANGO CORE CONFIGURATION
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string-in-production
DEBUG=False

# Platform Super Admin domain (e.g. prod.yourdomain.com in prod, or prod.localhost locally)
PLATFORM_DOMAIN=prod.yourdomain.com

# In multi-tenant environments with dynamic custom domains, AppTenantMiddleware
# validates all incoming hosts against registered Domain records in the database.
# Set to * to allow all registered tenant domains.
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# 3. CORS & CSRF CONFIGURATION
# ------------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com,https://prod.yourdomain.com
