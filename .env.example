# Multi-Tenant Note Taker - Environment Configuration Example
# Copy this file to .env and configure your values. Do NOT commit .env to version control.

# Database Settings (PostgreSQL)
DATABASE_NAME=multitenant_notes
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string-in-production
DEBUG=True

# Platform Domain (Used by Platform Admin)
PLATFORM_DOMAIN=prod.localhost

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,prod.localhost,abc.localhost,xyz.localhost

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://prod.localhost:5173,http://abc.localhost:5173,http://xyz.localhost:5173
